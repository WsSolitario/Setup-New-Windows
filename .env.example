PORT=3000
NODE_ENV=production
TRUST_PROXY=1

# Para ejecucion directa use DATABASE_URL o las variables PG*. Compose usa PG*.
DATABASE_URL=postgresql://workstation:change_me@postgres:5432/workstations
POSTGRES_PASSWORD=change_me
PGSSL=false

# URL externa HTTPS sin barra final, tal como la ven los equipos.
PUBLIC_BASE_URL=https://windows.ssdevsolutions.com

# Token aleatorio requerido por setup.ps1, stage2.ps1, Ninite y la API.
SETUP_TOKEN=replace_with_a_long_random_token

# Credenciales solicitadas para la cuenta local creada durante OOBE.
LOCAL_ADMIN_USERNAME=Plasencia
LOCAL_ADMIN_FULL_NAME=Nombre Plasencia
LOCAL_ADMIN_PASSWORD=Plasa66

# Ruta del instalador suministrado por el administrador.
NINITE_PATH=/app/artifacts/ninite.exe
